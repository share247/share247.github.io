rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating public 7-day ephemeral file sharing
    function isUnexpired(data) {
      return data.expiresAt > request.time;
    }

    function isValidFileCreation() {
      let data = request.resource.data;
      let requiredFields = [
        'id', 'name', 'size', 'formattedSize', 'type', 
        'extension', 'storagePath', 'downloadUrl', 
        'createdAt', 'expiresAt', 'downloadsCount'
      ];
      
      return data.keys().hasAll(requiredFields)
        && data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 255
        && data.size is number && data.size > 0 && data.size <= 104857600 // 100MB max
        && data.type is string
        && data.storagePath is string
        && data.downloadUrl is string
        && data.downloadsCount == 0
        && data.createdAt == request.time
        // Expiration must be set to 7 days from creation (allowing +/- 5 minutes clock skew)
        && data.expiresAt >= request.time + duration.value(6, 'd') + duration.value(23, 'h') + duration.value(55, 'm')
        && data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm');
    }

    function isDownloadIncrementOnly() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['downloadsCount'])
        && request.resource.data.downloadsCount == resource.data.downloadsCount + 1;
    }

    match /files/{fileId} {
      // Allow public read if file hasn't expired yet
      allow read: if isUnexpired(resource.data);

      // Allow public file creation adhering to 7-day TTL schema
      allow create: if isValidFileCreation();

      // Allow incrementing download counter only
      allow update: if isUnexpired(resource.data) && isDownloadIncrementOnly();

      // Deletion is handled automatically by Firestore TTL service
      allow delete: if false;
    }
  }
}
