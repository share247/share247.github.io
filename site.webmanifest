{
  "name": "Share247 — Instant File, Text & Link Sharing",
  "short_name": "Share247",
  "description": "Free temporary cloud vault for sharing files up to 100 MB, text snippets, source code, and web links with custom auto-delete timers and optional PIN lock.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121316",
